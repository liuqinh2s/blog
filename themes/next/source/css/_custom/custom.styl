// Custom styles.

// 块级数学公式（$$...$$）添加横向滚动
.MathJax_Display {
  overflow-x: auto;
  overflow-y: hidden;
  max-width: 100%;
  padding-bottom: 8px;
  margin: 1em 0 !important;
}

.post-body .MathJax_Display {
  max-width: 100%;
  overflow-x: auto;
  overflow-y: hidden;
}

// 行内数学公式容器处理
mjx-container {
  max-width: 100%;
  overflow-x: auto;
}

// 窄屏时让内容区域可以横向滚动（防止长公式撑宽页面）
@media (max-width: 767px) {
  .post-body,
  .post-body > * {
    overflow-x: auto;
    max-width: 100%;
  }

  // 防止表格和代码块也被影响，保持它们的原有行为
  .post-body table,
  .post-body .highlight,
  .post-body pre {
    overflow-x: auto;
  }
}
